APP_NAME=VPN SaaS Bot
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-super-secret-key
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TIMEZONE=Asia/Yekaterinburg

POSTGRES_DB=vpn_saas
POSTGRES_USER=vpn_user
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vpn_user:change-this-db-password@postgres:5432/vpn_saas
SYNC_DATABASE_URL=postgresql+psycopg://vpn_user:change-this-db-password@postgres:5432/vpn_saas

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BEAT_SCHEDULE_FILE=work/celerybeat-schedule

TELEGRAM_BOT_TOKEN=1234567890:replace-with-real-token
TELEGRAM_PROVIDER_TOKEN=
TELEGRAM_WEBHOOK_BASE=https://your-domain.example.com
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=replace-with-strong-webhook-secret
PUBLIC_BASE_URL=https://your-domain.example.com
TELEGRAM_SUPPORT_URL=
SUPPORT_USERNAME=
SUPPORT_EMAIL=
SUPPORT_TICKET_URL=
TELEGRAM_ADMIN_IDS=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_USE_POLLING=false
TELEGRAM_SET_COMMANDS_ON_STARTUP=true
TELEGRAM_SET_WEBHOOK_ON_STARTUP=true
PRIVACY_POLICY_URL=https://your-domain.example.com/privacy
TERMS_OF_SERVICE_URL=https://your-domain.example.com/terms

PAYMENT_PROVIDER=yookassa
PAYMENT_CURRENCY=RUB
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://your-domain.example.com/payment/success
YOOKASSA_WEBHOOK_SECRET=
PAYMENT_SUCCESS_TEXT=Платёж прошёл успешно. Подписка активирована.

DEFAULT_SERVER_ID=
DEFAULT_REFERRAL_REWARD_DAYS=7
DEFAULT_PROMOCODE_MAX_USES=100
DEFAULT_PROMOCODE_DISCOUNT_PERCENT=10

REMINDER_DAYS_BEFORE_1=1
REMINDER_DAYS_BEFORE_2=3
SUBSCRIPTION_GRACE_HOURS=0

QR_BOX_SIZE=8
QR_BORDER=2

NGINX_PORT=80

# Leave empty to disable the optional channel membership requirement.
TELEGRAM_REQUIRED_CHANNEL_USERNAME=
TELEGRAM_REQUIRED_CHANNEL_URL=
